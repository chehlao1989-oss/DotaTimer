# Виртуальное окружение
.venv/
venv/

# Python
__pycache__/
*.pyc
.pytest_cache/

# PyCharm
.idea/

# Сборка
build/
dist/
*.spec.bak

# Записи матчей, кеш, логи, личные настройки (на всякий случай, обычно они в %APPDATA%)
*.jsonl
*.log
cache/
recordings/
settings.json

# Урезанные записи для тестов коммитим
!tests/fixtures/*.jsonl

# Голос не распространяется (нет прав на распространение голосов Microsoft Edge):
# фразы генерируются у пользователя при первом запуске
assets/voice/
assets/voice_samples/

# Статистика публикуется как ассет релиза, не в истории
stats.json

# Настройки Claude Code проекта (хуки) — коммитим
!.claude/settings.json

# Временные файлы DuckDB при расчёте (tools/compute_recs.py)
.tmp/

# Сырые матчи, скачанные для проверок (tools/validate_recs.py) — в репозиторий не кладём
raw/
